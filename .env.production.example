# ─── Modèle de configuration production (VM Oracle Cloud + Docker Compose) ───
# Copier en ".env" sur le serveur, remplir les valeurs, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# Différences clés avec le .env de dev : les services ne sont plus atteints via
# 127.0.0.1:<port_publié_sur_l'hôte> mais via leur nom de service Docker
# (postgres, redis, rabbitmq, minio, judge0, libretranslate) sur le port interne
# standard — puisqu'aucun port n'est publié sur l'hôte à part Caddy (80/443).

APP_NAME=SkillForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tondomaine.com

# Domaine utilisé par Caddy pour générer le certificat HTTPS (Let's Encrypt)
API_DOMAIN=api.tondomaine.com

# ─── BASE DE DONNÉES ────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=skillforge
DB_USERNAME=skillforge_user
DB_PASSWORD=change-moi-mot-de-passe-fort

# ─── REDIS ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=rabbitmq

# ─── RABBITMQ ───────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=skillforge
RABBITMQ_PASSWORD=change-moi-mot-de-passe-fort
RABBITMQ_VHOST=/

# ─── MINIO (S3) ─────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=skillforge
AWS_SECRET_ACCESS_KEY=change-moi-mot-de-passe-fort
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=skillforge
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://api.tondomaine.com/storage

# ─── EMAIL ──────────────────────────────────────
# Fournisseur SMTP gratuit (ex: Brevo, Resend) — Mailpit n'existe pas en prod.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tondomaine.com
MAIL_FROM_NAME="SkillForge"

# ─── IA (Groq — https://console.groq.com) ──────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_FORMAT=wav

# ─── JUDGE0 (interne au réseau Docker) ─────────
JUDGE0_URL=http://judge0:2358

# ─── FRONTEND (Vercel) ──────────────────────────
FRONTEND_URL=https://tonapp.vercel.app
SANCTUM_STATEFUL_DOMAINS=tonapp.vercel.app

# ─── OAUTH GOOGLE ───────────────────────────────
# https://console.cloud.google.com/apis/credentials — mettre à jour l'URI de
# redirection autorisée côté Google avec la valeur ci-dessous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.tondomaine.com/api/auth/google/callback

# ─── TRADUCTION (contenu bilingue FR/EN) ────────
TRANSLATION_DRIVER=libretranslate
LIBRETRANSLATE_URL=http://libretranslate:5000

# ─── OAUTH GITHUB ───────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.tondomaine.com/api/auth/github/callback
