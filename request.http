### Challenge de la semaine
# @name currentChallenge
GET {{baseUrl}}/challenges/current
Authorization: Bearer {{token}}
Accept: application/json

###

@challenge_id = {{currentChallenge.response.body.challenge.id}}

### Soumettre une solution au challenge
POST {{baseUrl}}/challenges/{{challenge_id}}/submit
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "code_submitted": "<?php\nfunction fibonacci(int $n): int {\n    if ($n <= 1) return $n;\n    $a = 0; $b = 1;\n    for ($i = 2; $i <= $n; $i++) {\n        $temp = $a + $b;\n        $a = $b;\n        $b = $temp;\n    }\n    return $b;\n}\necho fibonacci(10);",
  "language": "php"
}

###

### Leaderboard du challenge
GET {{baseUrl}}/challenges/{{challenge_id}}/leaderboard
Authorization: Bearer {{token}}
Accept: application/json

